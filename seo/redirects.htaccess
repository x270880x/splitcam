# SplitCam migration 301 redirects + canonical URL form — Apache prod host
# Generated from seo/REDIRECTS.md (Ahrefs 2026-05-21), targets reconciled to the
# pages that actually exist on the redesigned site.
#
# PLACEMENT: paste ABOVE the "# BEGIN WordPress" block in the site root .htaccess
# (so these win before WP's front-controller rewrite). Anchored RedirectMatch =
# exact, no accidental prefix catches.
#
# ⚠️ PRODUCTION-ONLY. GitHub Pages (staging) ignores .htaccess entirely, so this is
#    inert until the static site is served from the cPanel/Apache host. TEST the
#    RewriteRule block on the host before go-live (watch for redirect loops with any
#    pre-existing WordPress rules — remove the old WP trailing-slash rule first).
#
# CANONICAL URL FORM — NO trailing slash (matches live splitcam.com):
#   splitcam.com canonicalises every page WITHOUT a trailing slash (/download,
#   /features, /privacy-policy …) and 301s the slashed form away. The redesign now
#   declares the same slashless canonicals/sitemap/hreflang, so Google maps the new
#   pages onto the already-indexed URLs instantly. The RewriteRule block below makes
#   the Apache host serve that form: strip the trailing slash (301) and serve the
#   directory's index.html for the slashless URL. The site root (/) and the locale
#   roots (/ru/, /es/, … two- or three-letter) KEEP their slash.
#
# KEY DECISION — /download is KEPT, not redirected:
#   /download has 556 referring domains + traffic + rankings (crown jewel) and the
#   word "download" is the literal search intent. /products is a separate hub
#   (product overview) — keep their on-page targeting distinct to avoid cannibalization.
#
# RECONCILED TARGETS (doc said /features/ and /whats-new/):
#   /tour, /more-plugins      -> /products    (/features is now BUILT — see below)
#   /splitcam-changes-win|mac -> /changelog
#
# NOT INCLUDED: adult-cam cluster (streamray/onlyfans/stripchat, ru bongacams/
#   stripchat) — already redirecting on the live host.
#
# KEEP (no redirect — same URL): / , /download, /features, /products, /help + /help/*
#   (753 rd hub), /blog/, /forum/, legal pages, /donate-us (now BUILT, all 35 locales),
#   installers /win-download/SplitCamSetup.msi(_x64).
#   (/contact-us now 301s to /help — see below.)

# --- dead URLs leaking equity (apply now) ---
RedirectMatch 301 ^/download\.html$                 https://splitcam.com/download
RedirectMatch 301 ^/downloadnew/?$                  https://splitcam.com/download
RedirectMatch 301 ^/SplitCamSetup\.exe$             https://splitcam.com/download
RedirectMatch 301 ^/russian(/.*)?$                  https://splitcam.com/ru/
RedirectMatch 301 ^/german/?$                       https://splitcam.com/de/
RedirectMatch 301 ^/aboutus\.html$                  https://splitcam.com/help
RedirectMatch 301 ^/cgi-sys/suspendedpage\.cgi$     https://splitcam.com/

# --- removed / changed pages (apply at migration) ---
RedirectMatch 301 ^/more-plugins/?$                 https://splitcam.com/products
RedirectMatch 301 ^/splitcam-changes-(win|mac)/?$   https://splitcam.com/changelog
RedirectMatch 301 ^/tour(/.*)?$                     https://splitcam.com/products
# contact-us -> help (the support hub: Telegram · Forum · FAQ). No static page rebuilt.
RedirectMatch 301 ^/contact-us/?$                   https://splitcam.com/help
RedirectMatch 301 ^/ru/kontakty/?$                  https://splitcam.com/ru/help
RedirectMatch 301 ^/es/contactenos/?$               https://splitcam.com/es/help

# --- locale (ru/es): old LOCALIZED slugs -> new English locale slugs ------------
# Live splitcam.com is localized only for ru + es, with translated slugs. Our redesign
# uses uniform English slugs under each locale prefix (/ru/features …), so 301 the old
# localized URLs onto the new ones to carry their equity (one hop). Help SUB-articles
# (/ru/help-ru/*, /es/ayuda/*) are NOT redirected — out of redesign scope, kept as-is;
# the help rules below are anchored to the hub only. ru/es contact slugs (/ru/kontakty,
# /es/contactenos) 301 to their /help in the dead-URL block above. donate-us is now BUILT
# in all 35 locales, so the old localized donate URLs map onto it.
RedirectMatch 301 ^/ru/osobennosti/?$                    https://splitcam.com/ru/features
RedirectMatch 301 ^/ru/downloads/?$                      https://splitcam.com/ru/products
RedirectMatch 301 ^/ru/help-ru/?$                        https://splitcam.com/ru/help
RedirectMatch 301 ^/ru/licenzionnoe-soglashenie/?$       https://splitcam.com/ru/license-agreement
RedirectMatch 301 ^/ru/politika-konfidencialnosti/?$     https://splitcam.com/ru/privacy-policy
RedirectMatch 301 ^/ru/pozhertvovat/?$                   https://splitcam.com/ru/donate-us
RedirectMatch 301 ^/ru/tour-ru(/.*)?$                    https://splitcam.com/ru/products
RedirectMatch 301 ^/es/caracteristicas/?$                https://splitcam.com/es/features
RedirectMatch 301 ^/es/descargar-el-programa/?$          https://splitcam.com/es/products
RedirectMatch 301 ^/es/ayuda/?$                          https://splitcam.com/es/help
RedirectMatch 301 ^/es/acuerdo-de-licencia/?$            https://splitcam.com/es/license-agreement
RedirectMatch 301 ^/es/privacy-policy-2/?$               https://splitcam.com/es/privacy-policy
RedirectMatch 301 ^/es/donarnos/?$                       https://splitcam.com/es/donate-us
RedirectMatch 301 ^/es/gira(/.*)?$                       https://splitcam.com/es/products

# --- optional (uncomment only if these are removed, not rebuilt) ---
# /features is now BUILT (replaces the old features page) — do NOT redirect it.
# RedirectMatch 301 ^/help/multi-streaming/?$        https://splitcam.com/multistreaming

# --- canonical URL form: strip trailing slash + serve directory index ---------
# Keep this block LAST. mod_rewrite; requires AllowOverride FileInfo.
RewriteEngine On
# 1) 301 the trailing-slash form to slashless — but NOT the site root or a locale
#    root (/ru/, /es/, /fil/ …), which legitimately keep their slash.
RewriteCond %{REQUEST_URI} !^/[a-z]{2,3}/$
RewriteRule ^(.+)/$ /$1 [R=301,L]
# 2) Internally serve <dir>/index.html for the slashless URL (no visible redirect).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]
